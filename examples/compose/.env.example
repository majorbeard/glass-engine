# Copy to .env and fill in. Keep .env private: it holds the engine's secrets.

# A name that points at this host. The engine gets its certificate for it.
GLASS_DOMAIN=glass.example.com

# Two different random values, made with: openssl rand -hex 32
# The API token is your backend's and your tools'; no browser ever needs it.
GLASS_API_TOKEN=
# The ticket secret is shared by the engine and the gate only.
GLASS_TICKET_SECRET=

# Your viewer: the page a link opens, and its origin (scheme and host, no path).
# The reference viewer (examples/viewer-preact) built and hosted anywhere works.
GLASS_VIEWER_URL=https://viewer.example.com
GLASS_VIEWER_ORIGIN=https://viewer.example.com

# Who gets a session: links (minted with `glass gate link`), open (anyone, within
# the gate's limits), or passphrase (with GLASS_GATE_PASSPHRASE).
GLASS_GATE=links
GLASS_GATE_PASSPHRASE=

# Optional: your license key (unset runs the free tier), and the image version.
GLASS_LICENSE_KEY=
GLASS_VERSION=latest
