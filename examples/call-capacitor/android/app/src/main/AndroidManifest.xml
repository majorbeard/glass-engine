<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- android:usesCleartextTraffic - a real Glass deployment on a LAN
         during dev/testing is plain http/ws, not https/wss. Android blocks
         cleartext traffic by default for apps targeting API 28+, which
         would otherwise silently break every request/connection to it. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- See StreamingForegroundService's own doc comment for why this
             exists at all - without it, Android's background execution
             limits kill the app's whole WebRTC session (camera+mic capture,
             the RTCPeerConnection) within moments of leaving the
             foreground, before the operator can even switch apps to share
             the session's watch link. foregroundServiceType must list every
             type the service actually starts with (StreamingForegroundService.
             onStartCommand's own ServiceCompat.startForeground call) - a
             mismatch throws at runtime on API 34+, it doesn't silently
             ignore the extra/missing type. -->
        <service
            android:name=".StreamingForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Real camera access for producer.ts's getUserMedia call - see
         MainActivity's onPermissionRequest override, which is also
         required for that call to actually receive frames (declaring
         this permission alone only lets the app request it, not grant a
         WebView's own permission prompt). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Real mic access for producer.ts's getUserMedia({audio:true}) call -
         same two-gate requirement as CAMERA above (see MainActivity's own
         doc comment): this declaration alone isn't sufficient, the runtime
         permission also has to be requested (MainActivity.onCreate). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Found live (2026-09-10, real device test - Samsung Galaxy A16):
         RECORD_AUDIO + onPermissionRequest granting RESOURCE_AUDIO_CAPTURE
         were both satisfied, mic access was confirmed working in the
         device's real Chrome app, and Auto Blocker was off - yet
         getUserMedia({audio:true}) still failed inside this app's embedded
         WebView specifically, with NotReadableError "Could not start audio
         source". A real Chrome app carries broader audio-session/focus
         handling a bare WebView doesn't get for free; MODIFY_AUDIO_SETTINGS
         is a normal (non-dangerous, no runtime dialog) permission that lets
         the WebView's own audio capture path adjust audio focus/settings
         instead of silently failing to open the hardware. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- StreamingForegroundService's own three permissions - all required
         together on API 34+ (targetSdkVersion, see android/variables.gradle):
         the base FOREGROUND_SERVICE permission plus one
         FOREGROUND_SERVICE_<TYPE> permission per foregroundServiceType the
         <service> tag above declares (camera, microphone). Missing any one
         of these throws a MissingForegroundServiceTypeException at
         startForeground() time on newer Android, not a silent no-op. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Required for the foreground-service notification's own
         setContentIntent (StreamingForegroundService's tap-to-reopen
         action) on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
