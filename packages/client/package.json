{
  "name": "@glass/client",
  "version": "0.1.0",
  "description": "Client SDK for the Glass runtime: connect to a session, render its video, and send input. DOM-free transport core plus an optional vanilla-DOM viewer.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "import": "./dist/viewer/index.js",
      "require": "./dist/viewer/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:check": "node scripts/api-snapshot.mjs",
    "api:update": "node scripts/api-snapshot.mjs --update"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9"
  }
}
